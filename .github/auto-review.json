  ],
  "forbid_patterns": [
    {
      "pattern": "(?i)\\b(?:les|des|aux|ces)\\s+(?:personnes\\s+)?(?:autistes?|TSA|Asperger|TDAH|TDA|dys(?:lexiques|praxiques|calculiques|orthographiques|phasiques)?|HPI|HP|HDC|z[eè]bres|surdou[ée]s|neuroatypiques|neurodivergent\\w*|malvoyants|non-voyants|aveugles|fibromyalgiques)\\b",
