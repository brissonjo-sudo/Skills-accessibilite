      "message": "Formulation essentialisante possible, sauf s'il s'agit d'un contre-exemple cite",
      "blocking": false
    },
    {
      "pattern": "(?i)\\bavec (?:ton|ta|votre|son|sa) (?:TDAH|TDA|TSA|autisme|HPI|dyslexie|fibromyalgie|handicap)\\b",
      "files": "skills/*",
      "message": "Imputation a une categorie possible, sauf s'il s'agit d'un contre-exemple cite",
