# Secrets — ne jamais committer
.env

# Sorties générées
*.html

# Résultats JSON bruts des nouveaux runs promptfoo — trop lourds pour le dépôt.
# Exception : les 13 archives historiques (7,5 Mo), ajoutées avant cette règle,
# restent suivies volontairement. Une règle d'ignore ne retire pas un fichier
# déjà suivi.
results*.json

# Runs du benchmark Claude Code (prompt_benchmark_claude_code.md).
# Volumineux, et surtout : blinding_map.json y contient la correspondance
# A/B → condition. La committer annulerait rétroactivement l'aveuglement du
# protocole. Le report.md d'un run peut être copié à la main hors de runs/
# s'il doit être partagé.
runs/

# Paquets de preuves : la table d'aveuglement et les réponses brutes n'y ont
# pas leur place (scripts/check_evidence.py les refuse aussi).
evidence/**/blinding_map.json
evidence/**/raw_generations.jsonl
evidence/**/judge_outputs/
